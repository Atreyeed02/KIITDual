# KIITDual frontend environment — copy to `.env.local` and adjust.
# Only VITE_-prefixed variables are exposed to the browser bundle, so NEVER put
# secrets here (no JWT secrets, DB URLs, SMTP passwords, API keys).
#
# The frontend currently runs fully on simulated services; these are read by
# src/config/env.ts and become active once the backend client is wired in.

# REST API origin (no trailing slash).
VITE_API_BASE_URL=http://localhost:5000

# Optional: WebSocket origin for /ws/match/:id. Defaults to VITE_API_BASE_URL
# with http→ws / https→wss when left unset.
# VITE_WS_BASE_URL=ws://localhost:5000
